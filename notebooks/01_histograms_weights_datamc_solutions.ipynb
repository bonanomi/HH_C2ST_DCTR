    "# Example process ranking by weighted yield in the displayed ll_pt range.\n",
    "channel = \"2mu\"\n",
    "feature = \"mli_ll_pt\"\n",
    "lo, hi = 0.0, 200.0\n",
    "\n",
    "mc, data = select_channel_tables(tables, channel)\n",
    "\n",
    "rows = []\n",
    "for df, label in mc:\n",
    "    values = df[feature].to_numpy()\n",
    "    weights = df[\"weight\"].to_numpy()\n",
    "    in_range = np.isfinite(values) & (values >= lo) & (values < hi)\n",
    "\n",
    "    rows.append(\n",
    "        {\n",
    "            \"process\": label,\n",
    "            \"rows in range\": int(in_range.sum()),\n",
    "            \"weighted yield\": float(weights[in_range].sum()),\n",
    "            \"sum |w|\": float(np.abs(weights[in_range]).sum()),\n",
    "        }\n",
    "    )\n",
    "\n",
    "ranking = pd.DataFrame(rows).sort_values(\"weighted yield\", ascending=False)\n",
    "display(ranking)"
   ]
